<mujoco model="d2p_pick_place">
  <include file="panda.xml"/>

  <statistic center="0.45 0 0.2" extent="0.9"/>
  <option timestep="0.002" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="140" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="cube_mat" rgba="0.9 0.25 0.2 1"/>
    <material name="target_mat" rgba="0.2 0.85 0.3 0.5"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" friction="1 0.005 0.0001"/>
    <body name="cube" pos="0.5 -0.15 0.02">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" mass="0.05" material="cube_mat"
            friction="1.5 0.01 0.001" condim="4"/>
    </body>
    <!-- Visual-only target zone; success is evaluated in code. -->
    <site name="target_site" pos="0.5 0.25 0.001" type="cylinder" size="0.04 0.0005" material="target_mat"/>
    <camera name="front" pos="1.3 0.0 0.55" xyaxes="0 1 0 -0.35 0 0.94" fovy="45"/>
  </worldbody>
</mujoco>
